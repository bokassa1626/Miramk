rules_version = '2';

// Boucherie Mira-Mk — toutes les données passent par l'API Node.js (Firebase Admin SDK),
// qui ignore ces règles. Aucun accès direct depuis un navigateur ou une application mobile :
// le frontend React ne lit ni n'écrit jamais dans Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
